# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# Environment
.venv/
env/

# Downloaded / derived data — regenerate with the pipeline
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# targets.csv is hand-verified against rcsb.org (Checkpoint 1), not mechanically
# regenerated — keep it in version control like the other reference/ verification work.
!data/processed/targets.csv
# rmsd_baseline.csv is a Checkpoint 2 *result*, not an intermediate: it's the experimental
# noise floor that makes every later model-vs-crystal RMSD interpretable. Regenerating it
# needs the (git-ignored) PDB downloads, so keep the numbers in version control.
!data/processed/rmsd_baseline.csv
# peptide_uniprot_map.csv is the Checkpoint 1 verification result (checklist steps 3-4):
# accession + residue range per peptide, plus the deamidation sites it confirms. A result,
# like targets.csv and rmsd_baseline.csv — keep it in version control.
!data/processed/peptide_uniprot_map.csv
# peptide_iedb_map.csv is the Checkpoint 1 verification result for checklist step 2
# (IEDB epitope ids + every candidate considered) — a result, so keep it. The .iedb_cache.json
# beside it is just a request cache and stays ignored.
!data/processed/peptide_iedb_map.csv

# Large model / structure outputs
results/structures/
*.cif
*.pdb.gz

# OS
.DS_Store

# Personal working copies of the generated notebooks — the user's own pass through a
# part, kept for taking notes. build_notebooks.py is the source; these are throwaway.
teaching/data8-project/project_datascience-Copy1.ipynb
teaching/data8-project/*draft*.ipynb

# Delivery bundles - rebuild with teaching/data8-project/package.py
teaching/data8-project/dist/
